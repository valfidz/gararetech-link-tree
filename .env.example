# ==============================================================================
# Database Configuration (Turso / libSQL / SQLite)
# Docs: https://docs.turso.tech/
# ==============================================================================
#
# Pilihan 1 - Turso Cloud (Rekomendasi Produksi & Staging):
# Dapatkan URL dan Token dari Turso Web Dashboard (https://app.turso.tech)
# Atau via Turso CLI:
#   turso db create katalog-affiliate
#   turso db show katalog-affiliate --url
#   turso db tokens create katalog-affiliate
#
DATABASE_URL=libsql://katalog-affiliate-yourorg.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token_here

# Pilihan 2 - SQLite Lokal (Pengembangan Offline):
# DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# Pilihan 3 - Turso Embedded Replicas (Cache Lokal dengan Sinkronisasi Cloud):
# DATABASE_URL=file:./local.db
# DATABASE_SYNC_URL=libsql://katalog-affiliate-yourorg.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token_here

# (Catatan: Variabel TURSO_DATABASE_URL dan TURSO_AUTH_TOKEN juga didukung)

# ==============================================================================
# Admin Authentication
# ==============================================================================
# Hash bcrypt dari kata sandi admin.
# Buat dengan menjalankan: npm run hash-password
ADMIN_PASSWORD_HASH=

# Session Secret (minimal 32 karakter acak untuk menandatangani cookie HMAC-SHA256)
SESSION_SECRET=

# ==============================================================================
# Public Site Configuration
# ==============================================================================
SITE_URL=http://localhost:3000
