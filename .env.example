# Database connection
# Untuk lokal: file:./local.db
# Untuk Turso: libsql://[nama-db]-[organisasi].turso.io
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Admin Authentication
# Hash bcrypt dari kata sandi admin (gunakan script hash password yang disediakan)
ADMIN_PASSWORD_HASH=

# Session Secret (minimal 32 karakter acak)
SESSION_SECRET=

# Public Site URL
SITE_URL=http://localhost:3000
